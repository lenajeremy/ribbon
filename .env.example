# Copy this file to .env and add your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Optional
# VOICE=coral            # the orb's voice (OpenAI text-to-speech voice name)
# CHECK_SECONDS=5        # how often the orb checks your screens during a focus session
# DRIFT_SECONDS=60       # how long you can drift before the orb speaks up
# PAUSE_MINUTES=5        # pause time allowed per focus session
